# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # public (anon/publishable) key, safe for the browser
SUPABASE_SERVICE_ROLE_KEY=            # secret key, server only, never in browser code

# ---------- Which provider does what ----------
# Options: vulavula | openai | mock
TRANSCRIPTION_PROVIDER=mock
TRANSLATION_PROVIDER=mock

# ---------- Vulavula (Lelapa AI) ----------
VULAVULA_API_KEY=

# ---------- OpenAI (only needed if you get a key) ----------
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSLATION_MODEL=             # fill in after checking OpenAI's models page

# ---------- App ----------
MAX_AUDIO_SECONDS=180